0001 0000 0000 0000 9193 01F0 0000 8000 chk  \ SLLI 00000001 = 80000000
0000 8000 0000 0000 D193 0010 0000 4000 chk  \ SRLI 80000000 = 40000000
FFFF FFFF 0000 0000 D193 0040 FFFF 0FFF chk  \ SRLI FFFFFFFF = 0FFFFFFF
0000 8000 0000 0000 D193 4010 0000 C000 chk  \ SRAI 80000000 = C0000000
FFFF FFFF 0000 0000 D193 4040 FFFF FFFF chk  \ SRAI FFFFFFFF = FFFFFFFF
\ --- memory: aligned LW/SW round-trip (5.7). Store x2 into guest RAM, load it back into x3. ---
: runi rv-ih ! rv-il ! rvstep ;                      ( irlo irhi -- : one instruction )
: eqx3 ( wlo whi -- )  WHI ! WLO !  03 rv-idx ! rvrd
  rv-s1hi @ WHI @ =  rv-s1lo @ WLO @ =  and
  if ." OK" else ." FAIL got=" rv-s1hi @ u. rv-s1lo @ u. ." want=" WHI @ u. WLO @ u. then cr ;
0010 0000 01 seedr  BEEF DEAD 02 seedr               \ x1 = 0x10 base, x2 = 0xDEADBEEF
A023 0020 runi  A183 0000 runi  BEEF DEAD eqx3        \ SW 0(x1); LW x3,0(x1) = DEADBEEF
A423 0020 runi  A183 0080 runi  BEEF DEAD eqx3        \ SW 8(x1); LW x3,8(x1) = DEADBEEF
2222 1111 02 seedr  A423 0020 runi                    \ x2 = 0x11112222; SW 8(x1)
A183 0000 runi  BEEF DEAD eqx3                         \ mem[0x10] untouched = DEADBEEF
A183 0080 runi  2222 1111 eqx3                         \ mem[0x18] updated = 11112222
0024 0000 05 seedr  BEEF DEAD 02 seedr                \ x5 = 0x24 base, x2 = 0xDEADBEEF
AE23 FE22 runi  A183 FFC2 runi  BEEF DEAD eqx3        \ SW -4(x5); LW x3,-4(x5) = DEADBEEF
\ --- sub-word memory LB/LH/LBU/LHU/SB/SH (5.7). Store a word, read bytes/halves back. ---
0010 0000 01 seedr  F3F4 F1F2 02 seedr           \ x1=0x10, x2=0xF1F2F3F4
A023 0020 runi                              \ SW x2,0(x1)
8183 0000 runi  FFF4 FFFF eqx3   \ LB 0 = FFFFFFF4
C183 0000 runi  00F4 0000 eqx3   \ LBU 0 = 000000F4
8183 0010 runi  FFF3 FFFF eqx3   \ LB 1 = FFFFFFF3
8183 0020 runi  FFF2 FFFF eqx3   \ LB 2 = FFFFFFF2
8183 0030 runi  FFF1 FFFF eqx3   \ LB 3 = FFFFFFF1
9183 0000 runi  F3F4 FFFF eqx3   \ LH 0 = FFFFF3F4
D183 0000 runi  F3F4 0000 eqx3   \ LHU 0 = 0000F3F4
9183 0020 runi  F1F2 FFFF eqx3   \ LH 2 = FFFFF1F2
0042 0000 02 seedr
A223 0020 runi                              \ SW 0x42 at 0x14
8183 0040 runi  0042 0000 eqx3   \ LB 4 positive
00AB 0000 02 seedr
80A3 0020 runi                              \ SB 0xAB at 0x11 high byte
A183 0000 runi  ABF4 F1F2 eqx3   \ LW = F1F2ABF4
00CD 0000 02 seedr
8023 0020 runi                              \ SB 0xCD at 0x10 low byte
A183 0000 runi  ABCD F1F2 eqx3   \ LW = F1F2ABCD
1234 0000 02 seedr
9123 0020 runi                              \ SH 0x1234 at 0x12
A183 0000 runi  ABCD 1234 eqx3   \ LW = 1234ABCD
\ --- branches BEQ/BNE/BLT/BGE/BLTU/BGEU (5.7). Set RVPC + regs, check RVPC = target or PC+4. ---
: setpc rv-pchi ! rv-pclo ! ;
: brun rv-ih ! rv-il ! rvstep ;
: chkpc ( wlo whi -- )  WHI ! WLO !  rv-pchi @ WHI @ =  rv-pclo @ WLO @ =  and
  if ." OK" else ." FAIL got=" rv-pchi @ u. rv-pclo @ u. ." want=" WHI @ u. WLO @ u. then cr ;
0005 0000 01 seedr  0005 0000 02 seedr  0100 0000 setpc
8463 0020 brun  0108 0000 chkpc   \ BEQ r1=5 r2=5 off=8 pc=100
0005 0000 01 seedr  0006 0000 02 seedr  0100 0000 setpc
8463 0020 brun  0104 0000 chkpc   \ BEQ r1=5 r2=6 off=8 pc=100
0005 0000 01 seedr  0006 0000 02 seedr  0100 0000 setpc
9463 0020 brun  0108 0000 chkpc   \ BNE r1=5 r2=6 off=8 pc=100
0005 0000 01 seedr  0005 0000 02 seedr  0100 0000 setpc
9463 0020 brun  0104 0000 chkpc   \ BNE r1=5 r2=5 off=8 pc=100
FFFF FFFF 01 seedr  0001 0000 02 seedr  0100 0000 setpc
C863 0020 brun  0110 0000 chkpc   \ BLT r1=FFFFFFFF r2=1 off=16 pc=100
0001 0000 01 seedr  FFFF FFFF 02 seedr  0100 0000 setpc
C863 0020 brun  0104 0000 chkpc   \ BLT r1=1 r2=FFFFFFFF off=16 pc=100
0001 0000 01 seedr  FFFF FFFF 02 seedr  0100 0000 setpc
D863 0020 brun  0110 0000 chkpc   \ BGE r1=1 r2=FFFFFFFF off=16 pc=100
FFFF FFFF 01 seedr  0001 0000 02 seedr  0100 0000 setpc
D863 0020 brun  0104 0000 chkpc   \ BGE r1=FFFFFFFF r2=1 off=16 pc=100
0001 0000 01 seedr  FFFF FFFF 02 seedr  0100 0000 setpc
