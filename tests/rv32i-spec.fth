0F0F 0F0F 0000 0000 C193 FFF0 F0F0 F0F0 chk  \ XORI 0F0F0F0F = F0F0F0F0
0005 0000 0000 0000 A193 00A0 0001 0000 chk  \ SLTI 00000005 = 00000001
000A 0000 0000 0000 A193 0050 0000 0000 chk  \ SLTI 0000000A = 00000000
