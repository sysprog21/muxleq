0000 FFFF 0000 0001 81B3 0020 0000 0000 chk  \ ADD FFFF0000 = 00000000
0005 0000 0003 0000 81B3 4020 0002 0000 chk  \ SUB 00000005 = 00000002
0003 0000 0005 0000 81B3 4020 FFFE FFFF chk  \ SUB 00000003 = FFFFFFFE
0000 0001 0001 0000 81B3 4020 FFFF 0000 chk  \ SUB 00010000 = 0000FFFF
0000 8000 0001 0000 81B3 4020 FFFF 7FFF chk  \ SUB 80000000 = 7FFFFFFF
0000 0000 0000 0000 81B3 4020 0000 0000 chk  \ SUB 00000000 = 00000000
