0000 0000 0000 0000 E1B3 0020 0000 0000 chk  \ OR 00000000 = 00000000
5678 1234 0000 0000 E1B3 0020 5678 1234 chk  \ OR 12345678 = 12345678
5555 AAAA AAAA 5555 E1B3 0020 FFFF FFFF chk  \ OR AAAA5555 = FFFFFFFF
0001 0000 0000 0000 91B3 0020 0001 0000 chk  \ SLL 00000001 = 00000001
0001 0000 0001 0000 91B3 0020 0002 0000 chk  \ SLL 00000001 = 00000002
